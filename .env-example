# Database credentials untuk Docker Compose
MYSQL_DATABASE=mikrobackup
MYSQL_USER=mikrobackup_user
MYSQL_PASSWORD=passwordkuat
MYSQL_ROOT_PASSWORD=root_password_sangat_kuat
DATABASE_URL=mysql+pymysql://mikrobackup_user:passwordkuat@db:3306/mikrobackup

# Konfigurasi Flask
SECRET_KEY=ganti_dengan_string_acak_yang_sangat_panjang_dan_aman
SESSION_COOKIE_SECURE=false
FLASK_ENV=production

# Optional: auto-create admin user saat startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPassword123
